# Copy to .env (gitignored) and add an OpenRouter key: it is the only thing jesteruct needs.
# One key serves both models, TypeSafe Jev (the classifier) and Gemini 3.8 Flash (the vision check),
# with no other sign-up. Create it at https://openrouter.ai/settings/keys; the account needs a little credit.
OPENROUTER_API_KEY=

# Everything else is optional. Settings are JST_<NAME>, all listed in src/jesteruct/config.py.
# Exported environment variables win over this file, except that make studio and make deploy-local
# always read the key from here, since a shell can export a stale one.

# Where inputs, manifests and the provider response cache go: file://, s3://, gs:// or az://.
# JST_STORE_URL=file://.jst

# Any Redis-protocol service, for the API and workers (jst serve, jst worker); make studio sets it.
# JST_VALKEY_URL=redis://localhost:6379/0

# auto uses Apple Vision on macOS and RapidOCR elsewhere; apple or rapid forces one.
# JST_OCR_BACKEND=auto

# Pages in flight per worker; each waits seconds on the models and needs about 50 ms of CPU.
# JST_PAGE_CONCURRENCY=32

# Review uses the shipped calibration; with it off, pages whose raw confidence is below the threshold go to LH.
# JST_USE_CALIBRATION=true
# JST_REVIEW_THRESHOLD=0.5
